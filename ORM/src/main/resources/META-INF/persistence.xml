<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
			 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			 xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
			 version="3.0">
	<persistence-unit name="persistencia" transaction-type="RESOURCE_LOCAL">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
		<class>Modelo.Compra</class>
		<class>model.Producto</class>

		<properties>
			<!-- JDBC connection para XAMPP MySQL -->
			<property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
			<property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/catalogo_productos?useSSL=false&amp;serverTimezone=UTC"/>
			<property name="jakarta.persistence.jdbc.user" value="root"/>
			<property name="jakarta.persistence.jdbc.password" value=""/>

			<!-- EclipseLink configuration -->
			<property name="eclipselink.logging.level" value="INFO"/>
			<property name="eclipselink.logging.logger" value="DefaultLogger"/>
			<!-- DDL: create - crea las tablas si no existen; update - actualiza el esquema -->
			<property name="eclipselink.ddl-generation" value="drop-and-create-tables"/>
			<property name="eclipselink.ddl-generation.output-mode" value="database"/>
		</properties>
	</persistence-unit>
</persistence>
